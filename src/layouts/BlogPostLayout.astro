---
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  category: string;
  author: string;
  pubDate: Date;
  image?: {
    src: ImageMetadata;
    alt: string;
  };
}

const {
  title,
  description,
  category,
  author,
  pubDate,
  image
} = Astro.props;
---

<article class="blog-post">
  <header class="post-header">
    <p class="category">{category}</p>

    <h1>{title}</h1>

    <p class="description">{description}</p>

    <div class="meta">
      <span>By {author}</span>
      <span>{pubDate.toLocaleDateString()}</span>
    </div>
  </header>

  {image && (
    <Image
      class="post-image"
      src={image.src}
      alt={image.alt}
      width={1200}
      height={700}
    />
  )}

  <div class="content">
    <slot />
  </div>
</article>

<style>
  .blog-post {
    max-width: 800px;
    margin: auto;
    padding: 120px 30px;
  }

  .post-header {
    margin-bottom: 60px;
  }

  .category {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  h1 {
    margin: 25px 0;

    font-size: clamp(45px, 7vw, 80px);
    line-height: 0.95;
    letter-spacing: -4px;
  }

  .description {
    color: #686868;
    font-size: 18px;
    line-height: 1.7;
  }

  .meta {
    display: flex;
    gap: 20px;

    margin-top: 30px;
    padding-top: 20px;

    border-top: 1px solid #ddd;

    color: #888;
    font-size: 13px;
  }

  .post-image {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 50px;
    border-radius: 16px;
  }

  .content {
    font-size: 18px;
    line-height: 1.8;
  }

  .content :global(h2) {
    margin-top: 50px;
    font-size: 32px;
    line-height: 1.1;
  }

  .content :global(p) {
    color: #555;
  }

  .content :global(li) {
    margin-bottom: 10px;
  }
</style>