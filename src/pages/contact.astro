---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "../styles/global.css";
---

<Layout
  title="Contact — Growthly"
  description="Get in touch with Growthly about your next digital marketing project."
>
  <Header />

  <main>
    <section class="contact">
      <div class="intro">
        <p class="eyebrow">GET IN TOUCH</p>

        <h1>
          Let's talk about
          <span>your next project.</span>
        </h1>

        <p>
          Tell us a little about your business and what you're
          looking to achieve. We'll get back to you soon.
        </p>
      </div>

      <form class="contact-form">
        <div class="field">
          <label for="name">Name</label>
          <input
            id="name"
            name="name"
            type="text"
            placeholder="Your name"
            required
          />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            placeholder="you@example.com"
            required
          />
        </div>

        <div class="field">
          <label for="company">Company</label>
          <input
            id="company"
            name="company"
            type="text"
            placeholder="Your company"
          />
        </div>

        <div class="field">
          <label for="message">Message</label>
          <textarea
            id="message"
            name="message"
            rows="6"
            placeholder="Tell us about your project..."
            required
          ></textarea>
        </div>

        <button type="submit">
          Send Message →
        </button>
      </form>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .contact {
    max-width: 1200px;
    margin: auto;
    padding: 120px 30px;

    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  h1 {
    margin: 25px 0;

    font-size: clamp(50px, 6vw, 80px);
    line-height: 0.95;
    letter-spacing: -4px;
  }

  h1 span {
    color: #888;
  }

  .intro > p:last-child {
    max-width: 500px;

    color: #686868;
    font-size: 17px;
    line-height: 1.7;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 25px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  label {
    font-size: 13px;
    font-weight: 700;
  }

  input,
  textarea {
    width: 100%;
    padding: 15px;

    border: 1px solid #ddd;
    border-radius: 8px;

    background: white;
    color: #111;

    font: inherit;
  }

  input:focus,
  textarea:focus {
    outline: 2px solid #b8f34a;
    border-color: transparent;
  }

  textarea {
    resize: vertical;
  }

  button {
    width: fit-content;

    padding: 16px 25px;

    border: none;
    border-radius: 30px;

    background: #111;
    color: white;

    font-weight: 700;
    font-size: 14px;
  }

  @media (max-width: 700px) {
    .contact {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }
</style>